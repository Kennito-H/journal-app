<% if (typeof currentTag !== 'undefined' && currentTag) { %>
  <div style="background-color: #f0f0f0; padding: 10px; margin-bottom: 15px; border-radius: 5px;">
    <strong>Showing entries tagged with:</strong> #<%= currentTag %> 
    <a href="/entries" style="margin-left: 10px; text-decoration: underline;">Clear Filter</a>
  </div>
<% } %>

<h1>All Journal Entries</h1>
<div style="margin-bottom: 20px;">
  <a href="/tags" style="background-color: #0056b3; color: white; padding: 8px 15px; text-decoration: none; border-radius: 5px; font-weight: bold;">
    Browse All Tags
  </a>
</div>

<ul>
  <% entries.forEach((entry) => { %>
    <li><a href="/entries/<%= entry.id %>"><%= entry.content %></a></li>
  <% }) %>
</ul>

