<%- contentFor('body') %>

<h1>All Categories</h1>

<% if (tags && tags.length > 0) { %>
  <ul style="list-style: none; padding: 0; display: flex; gap: 15px; flex-wrap: wrap; margin-top: 20px;">
    <% tags.forEach(function(tag) { %>
      <li>
        <a 
          href="/tags/<%= tag %>" 
          style="background-color: #e0e0e0; padding: 10px 18px; border-radius: 20px; text-decoration: none; color: #333; font-weight: bold;"
        >
          #<%= tag %>
        </a>
      </li>
    <% }); %>
  </ul>
<% } else { %>
  <p>No tags have been created yet. Add a tag to an entry to see it here!</p>
<% } %>

<div style="margin-top: 30px;">
  <p><a href="/entries">Back to All Entries</a></p>
</div>